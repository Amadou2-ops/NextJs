# ---------------------------------------------------------------------------
# TransfertPlus — variables d'environnement (EXEMPLE, aucune valeur réelle).
# Copier en .env pour le développement local uniquement. En staging/production,
# les valeurs proviennent du gestionnaire de secrets (jamais d'un fichier).
# ---------------------------------------------------------------------------

# Environnement logique : development | test | staging | production.
# Chaque environnement utilise un projet Supabase, des clés Stripe/Flutterwave
# et des clés KMS distincts. Aucune ressource n'est partagée entre environnements.
APP_ENV=development

# Connexion utilisée par l'outil de migration (rôle propriétaire du schéma).
# Supabase : utiliser la connexion directe (port 5432), pas le pooler en mode
# transaction, car les migrations utilisent des verrous consultatifs de session.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/transfertplus

# Base dédiée aux tests automatisés (recréée par la suite de tests).
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/transfertplus_test

# TLS vers PostgreSQL : disable (local) | require | verify-full (staging/prod).
DATABASE_SSL_MODE=disable
# Chemin du certificat CA du fournisseur (obligatoire avec verify-full).
DATABASE_SSL_CA_PATH=

# Mots de passe des conteneurs locaux (docker-compose uniquement).
POSTGRES_PASSWORD=postgres
REDIS_PASSWORD=local-redis-password
