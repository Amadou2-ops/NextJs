# Back-office TransfertPlus (Next.js). Aucune valeur réelle ici.
# URL interne de l'API (réseau privé ; jamais exposée au navigateur).
API_BASE_URL=http://localhost:8080
# Origine publique exacte du back-office : doit figurer dans ADMIN_WEBAUTHN_ORIGINS
# côté API (clés de sécurité) ; https obligatoire en production.
APP_ORIGIN=http://localhost:3001
# Clé de chiffrement des cookies, 32 octets en base64, DISTINCTE de celle du site client.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_ENCRYPTION_KEY=
# Clé précédente, acceptée en lecture seule pendant une rotation.
SESSION_ENCRYPTION_KEY_PREVIOUS=
API_TIMEOUT_MS=10000
# Relais de confiance devant le back-office (l'adresse du navigateur est contrôlée
# par l'API contre les plages autorisées du membre).
TRUSTED_PROXY_HOPS=1
