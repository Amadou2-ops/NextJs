# Site client TransfertPlus (Next.js). Aucune valeur réelle ici.
# URL interne de l'API (réseau privé ; jamais exposée au navigateur).
API_BASE_URL=http://localhost:8080
# Origine publique exacte du site (https obligatoire en production).
APP_ORIGIN=http://localhost:3000
# Clé de chiffrement des cookies de session : 32 octets en base64.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_ENCRYPTION_KEY=
# Clé précédente, acceptée en lecture seule pendant une rotation.
SESSION_ENCRYPTION_KEY_PREVIOUS=
# Délai maximal d'un appel à l'API (ms).
API_TIMEOUT_MS=10000
# Nombre de relais de confiance (répartiteur de charge) devant le site.
TRUSTED_PROXY_HOPS=1
