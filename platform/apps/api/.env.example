# ---------------------------------------------------------------------------
# API TransfertPlus — EXEMPLE pour le développement local uniquement.
# En staging/production, chaque valeur vient du gestionnaire de secrets.
# Générer des clés locales :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ---------------------------------------------------------------------------
APP_ENV=development
APP_VERSION=0.0.0-dev
HOST=127.0.0.1
PORT=8080
TRUST_PROXY_HOPS=0
LOG_LEVEL=debug

# Identifiant rattaché au rôle de groupe app_api (jamais le propriétaire du schéma).
# En local, le paramètre options force le rôle sur une connexion propriétaire.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/transfertplus?options=-c%20role%3Dapp_api
DATABASE_SSL_MODE=disable
DATABASE_SSL_CA_PATH=
DATABASE_POOL_MAX=20
DATABASE_STATEMENT_TIMEOUT_MS=10000

REDIS_URL=redis://:local-redis-password@127.0.0.1:63799

# Origines exactes du site web client et du dashboard (séparées par des virgules).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

JWT_ISSUER=http://localhost:8080
# Clés PUBLIQUES Ed25519 au format JWKS (jeux distincts clients / personnel).
JWT_CUSTOMER_PUBLIC_JWKS={"keys":[{"kty":"OKP","crv":"Ed25519","x":"REMPLACER_PAR_LA_CLE_PUBLIQUE_BASE64URL_43C","kid":"customer-dev-0001","alg":"EdDSA","use":"sig"}]}
JWT_ADMIN_PUBLIC_JWKS={"keys":[{"kty":"OKP","crv":"Ed25519","x":"REMPLACER_PAR_LA_CLE_PUBLIQUE_BASE64URL_43C","kid":"admin-dev-00001","alg":"EdDSA","use":"sig"}]}

# Trousseau des clés de chiffrement des données personnelles (32 octets base64).
PII_KEYRING={"activeKeyId":"pii-dev-1","keys":{"pii-dev-1":"REMPLACER_PAR_32_OCTETS_EN_BASE64============"}}
# Clé HMAC des index aveugles (32 octets base64, distincte des clés PII).
BLIND_INDEX_KEY=REMPLACER_PAR_32_OCTETS_EN_BASE64============

# --- Authentification -------------------------------------------------------
# Clé PRIVÉE Ed25519 de signature des jetons clients (JWK). Sa partie publique
# (même kid, même x) doit figurer dans JWT_CUSTOMER_PUBLIC_JWKS. Générer :
#   node -e "const {generateKeyPairSync}=require('crypto');const k=generateKeyPairSync('ed25519').privateKey.export({format:'jwk'});console.log(JSON.stringify({...k,kid:'customer-dev-0001',alg:'EdDSA',use:'sig'}))"
JWT_CUSTOMER_SIGNING_KEY={"kty":"OKP","crv":"Ed25519","x":"REMPLACER","d":"REMPLACER","kid":"customer-dev-0001","alg":"EdDSA","use":"sig"}
# Clé HMAC des codes SMS (32 octets base64, distincte des autres clés).
OTP_HMAC_KEY=REMPLACER_PAR_32_OCTETS_EN_BASE64============

# SMS : "log" (développement, codes visibles dans les journaux) ou "twilio".
SMS_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# Passkeys du site web client.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=TransfertPlus
WEBAUTHN_ORIGINS=http://localhost:3000

# Attestation iOS (App Attest) : TEAMID.bundle.id, séparés par des virgules.
APPLE_APP_ATTEST_APP_IDS=
APPLE_APP_ATTEST_ALLOW_DEVELOPMENT=true
# Attestation Android (Play Integrity) : les trois valeurs ensemble ou aucune.
ANDROID_PACKAGE_NAME=
ANDROID_SIGNING_CERT_SHA256=
GOOGLE_PLAY_INTEGRITY_SERVICE_ACCOUNT=

# Contrôle des mots de passe compromis (Have I Been Pwned). Obligatoire en production.
PASSWORD_BREACH_CHECK=enabled

# --- Registre : ancrage externe et tâches de fond (processus worker) --------
# Autorité d'horodatage RFC 3161 (obligatoire en production) et certificats de
# confiance au format PEM (racine de la TSA et/ou son certificat).
TSA_URL=
TSA_TRUSTED_CERTS_PATH=
TSA_ANCHOR_TARGET=rfc3161-tsa
RECONCILIATION_INTERVAL_MINUTES=60
ANCHOR_INTERVAL_MINUTES=360

# --- Change ----------------------------------------------------------------
# Au moins un fournisseur obligatoire en production ; le second sert au
# contrôle de divergence. Open Exchange Rates : App ID (32 hex) ; Fixer
# (APILayer) : clé de 32 caractères alphanumériques.
OPEN_EXCHANGE_RATES_APP_ID=
FIXER_API_KEY=
FX_PRIMARY_PROVIDER=open_exchange_rates
FX_REFRESH_INTERVAL_MINUTES=15
FX_MAX_RATE_AGE_MINUTES=120
FX_MAX_DIVERGENCE_BPS=200
FX_MAX_JUMP_BPS=1000
FX_QUOTE_TTL_SECONDS=600
