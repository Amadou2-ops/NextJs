<?xml version="1.0" encoding="utf-8"?>
<!-- Production : TLS uniquement, autorités du système seulement (aucune autorité ajoutée par l'utilisateur). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
