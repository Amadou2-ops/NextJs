# API et worker TransfertPlus — configuration de production (sans secret
# cryptographique : voir api.secrets.env, produit par scripts/generate-secrets.mjs).
# Chaque valeur est validée au démarrage (apps/api/src/config/env.ts) : une
# configuration de production incomplète ou dangereuse empêche le démarrage.

APP_ENV=production
APP_VERSION=1.0.0
PORT=8080
# Seul relais de confiance : Caddy (mobile) ou le BFF (site, back-office).
TRUST_PROXY_HOPS=1
LOG_LEVEL=info

# --- PostgreSQL (Supabase) : identifiant api_prod (membre de app_api), TLS vérifié ---
DATABASE_URL=postgres://api_prod:CHANGER@db.PROJET.supabase.co:5432/postgres
DATABASE_SSL_MODE=verify-full
DATABASE_SSL_CA_PATH=/run/secrets/supabase-ca.crt
DATABASE_POOL_MAX=20

# --- Redis (réseau interne) -------------------------------------------------
REDIS_URL=redis://:CHANGER@redis:6379/0

CORS_ALLOWED_ORIGINS=
JWT_ISSUER=https://api.transfertplus.com

# --- Personnel (WebAuthn) ---------------------------------------------------
ADMIN_WEBAUTHN_RP_ID=admin.transfertplus.com
ADMIN_WEBAUTHN_ORIGINS=https://admin.transfertplus.com
ADMIN_ENROLLMENT_URL=https://admin.transfertplus.com/enrolement
# Modèles de clés matérielles autorisés (AAGUID), recommandé :
ADMIN_WEBAUTHN_ALLOWED_AAGUIDS=

# --- Clients (passkeys web, attestation mobile) -----------------------------
WEBAUTHN_RP_ID=transfertplus.com
WEBAUTHN_ORIGINS=https://app.transfertplus.com
APPLE_APP_ATTEST_APP_IDS=EQUIPE1234.com.transfertplus.app
ANDROID_PACKAGE_NAME=com.transfertplus.app
ANDROID_SIGNING_CERT_SHA256=
GOOGLE_PLAY_INTEGRITY_SERVICE_ACCOUNT=

# --- SMS (Twilio) -----------------------------------------------------------
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# --- Registre : ancrage horodaté RFC 3161 (obligatoire) ----------------------
TSA_URL=
TSA_TRUSTED_CERTS_PATH=/run/secrets/tsa-ca.pem

# --- Taux de change ---------------------------------------------------------
OPEN_EXCHANGE_RATES_APP_ID=
FIXER_API_KEY=

# --- KYC --------------------------------------------------------------------
ONFIDO_API_TOKEN=
ONFIDO_REGION=eu
ONFIDO_WEBHOOK_TOKEN=
ONFIDO_WORKFLOW_DOCUMENT_VERIFICATION=
SMILE_ID_PARTNER_ID=
SMILE_ID_API_KEY=
SMILE_ID_ENVIRONMENT=production
SMILE_ID_CALLBACK_URL=https://api.transfertplus.com/v1/webhooks/smile-id

# --- Paiements --------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
FLUTTERWAVE_REDIRECT_URL=https://app.transfertplus.com/transferts
THUNES_BASE_URL=
THUNES_API_KEY=
THUNES_API_SECRET=
THUNES_CALLBACK_URL=https://api.transfertplus.com/v1/webhooks/thunes
THUNES_CALLBACK_ALLOWED_IPS=

# --- LCB-FT -----------------------------------------------------------------
AML_OPENSANCTIONS_PEP_URL=
AML_OPENSANCTIONS_API_KEY=
